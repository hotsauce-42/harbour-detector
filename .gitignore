# Secrets
.env
.env.local

# Python
__pycache__/
*/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
venv-*/
env/

# Data — raw input and large intermediates are never committed
data/raw/
data/interim/
#data/reference/

# Pipeline output — regenerated by running the pipeline
data/existing_db/harbours.geojson
data/output/harbours.parquet

# Keep the output directory itself
!data/output/.gitkeep
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/reference/.gitkeep

# Streamlit — config.toml is part of the app; secrets.toml must never be
.streamlit/*
!.streamlit/config.toml

# Vendored Leaflet assets — downloaded by scripts/vendor_map_assets.py
#static/vendor/

# Pytest
.pytest_cache/
tests/__pycache__
tests/__pycache__/test_phase4.cpython-312-pytest-9.0.3.pyc
/tmp/

